// TcFormatter preset for the company guideline in plc-coding-guidelines.md ("TCAT Programmierrichtlinien").
// Copy this file as ".tcformat.json" next to the .sln / .plcproj (or into a sub folder) to use it.
// Only the settings that differ from the built-in defaults are listed; run "tcfmt init" to see all options.
{
  "format": {
    // Consolas 10, tab width 4, indent one tab per IF / FOR / WHILE / REPEAT; CASE labels and bodies indented
    "indentStyle": "Tabs",
    "indentSize": 4,
    // declarations: name indented one tab, type at tab 10 (tab width 4 -> column 37)
    "declarationTypeColumn": 37,
    // assignments are not aligned: "a := b;"
    "alignConsecutiveAssignments": false,
    // FB calls keep the F2 layout: no space before := / =>
    "spaceBeforeArgumentAssignment": false,
    // wrapped IF conditions continue directly under the IF, without an indent
    "indentConditionContinuation": false,
    // wrapped conditions / calculations assigned to a variable continue under the :=
    "alignContinuationToAssignment": true,
    // a line has at most 150 characters
    "maxLineLength": 150,
    // main sections are preceded by 2 blank lines
    "maxConsecutiveBlankLines": 2
  },
  "naming": {
    "typePrefixes": {
      "BOOL": "b_",
      "BYTE": "by_",
      "WORD": "w_",
      "DWORD": "dw_",
      "SINT": "sn_",
      "USINT": "usn_",
      "INT": "n_",
      "UINT": "un_",
      "DINT": "dn_",
      "UDINT": "udn_",
      "REAL": "r_",
      "LREAL": "lr_",
      "STRING": "str_",
      "TIME": "time_",
      "DATE": "date_",
      "TOD": "dayt_",
      "TIME_OF_DAY": "dayt_",
      "DT": "datet_",
      "DATE_AND_TIME": "datet_",
      "T_DCTIME64": "dctime64_",
      "T_DCTIME32": "dctime32_",
      "AXIS_REF": "ax_",
      "TON": "ton_",
      "TOF": "tof_",
      "TP": "tp_",
      "CTU": "ctu_",
      "CTD": "ctd_",
      "CTUD": "ctud_",
      "R_TRIG": "osr_",
      "F_TRIG": "osf_",
      // FB instances: fb_BlockNamePlus
      "_FB_*": "fb_",
      // DUT variables have no type prefix (vi_Data, InControl)
      "T*": "",
      // Beckhoff-style defaults that do not apply here
      "FB_*": null,
      "MC_*": null,
      "ST_*": null,
      "E_*": null,
      "I_*": null
    },
    // the guideline defines no array prefix: arrays use the prefix of their element type (ARRAY OF LREAL -> lr_)
    "arrayPrefix": "",
    "arrayIncludesElementPrefix": true,
    "pointerPrefix": "p_",
    "referencePrefix": "ref_",
    // inputs / outputs: vi_ / vo_ / vio_ + [t_]Name, e.g. vi_b_Init, vo_str_ErrorText
    "scopePrefixes": {
      "VAR_INPUT": "vi_",
      "VAR_OUTPUT": "vo_",
      "VAR_IN_OUT": "vio_"
    },
    // constants: t_CONSTANT_NAME, e.g. dn_MAX_LIGHT_CYCLES
    "constantPrefix": "",
    "constantNameCase": "UpperCase",
    // all local variables of a method start with Temp: lr_TempAngle
    "methodLocalMarker": "Temp",
    "objectPrefixes": {
      "FUNCTION_BLOCK": "_FB_",
      "FUNCTION": "_FC_",
      "METHOD": "m_",
      "ACTION": "act_",
      "PROGRAM": "",
      "STRUCT": "T",
      "UNION": "T",
      "ALIAS": "T",
      "ENUM": "",
      "GVL": "",
      "PROPERTY": ""
    },
    "allowLeadingUnderscore": true,
    // enum values are upper case without type prefix: INIT, OPEN_GEAR
    "enumValueCase": "UpperCase",
    "ignoreNames": ["^MAIN$", "^lbl_End$"]
  }
}
