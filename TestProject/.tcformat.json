{
  // TcFormatter configuration. Applies to all TwinCAT objects in this folder and below.
  "format": {
    // Indent with tabs or spaces. Alignment inside lines always uses spaces. Values: Tabs | Spaces.
    "indentStyle": "Tabs",
    // Number of spaces per indentation level (also the tab width used to compute line length).
    "indentSize": 4,
    // Extra indentation levels for continuation lines of a statement that spans several lines.
    "continuationIndent": 1,
    // Indent continuation lines of IF / ELSIF / WHILE / UNTIL conditions. Off: they continue directly under the IF.
    "indentConditionContinuation": true,
    // Align continuation lines of an assignment under its ':=' (e.g. 'bOk := bA' / '       AND bB;').
    "alignContinuationToAssignment": false,
    // Indent the members of VAR...END_VAR sections.
    "indentVarBlocks": true,
    // Indent the members of STRUCT/UNION definitions.
    "indentStructMembers": true,
    // Indent CASE labels relative to CASE.
    "indentCaseLabels": true,
    // Indent statements below a CASE label relative to the label.
    "indentCaseBody": true,
    // Indent code between {region} and {endregion} pragmas.
    "indentRegions": false,
    // Line ending of the result. Auto keeps the dominant line ending of the input (CRLF when none). Values: Auto | CrLf | Lf.
    "lineEnding": "Auto",
    // Maximum number of consecutive blank lines that are kept.
    "maxConsecutiveBlankLines": 1,
    // Remove blank lines directly after a block opener (THEN, DO, VAR, ...).
    "removeBlankLinesAtBlockStart": true,
    // Remove blank lines directly before a block closer (END_IF, ELSE, END_VAR, ...).
    "removeBlankLinesAtBlockEnd": true,
    // Whether the text ends with a line break. Values: Preserve | Add | Remove.
    "finalNewline": "Preserve",
    // Put every statement on its own line (splits 'a := 1; b := 2;').
    "oneStatementPerLine": true,
    // Expand single-line blocks like 'IF a THEN b := 1; END_IF' into several lines.
    "expandSingleLineBlocks": true,
    // Put the statement after a CASE label on its own line.
    "caseStatementOnNewLine": true,
    // Maximum line length used for wrapping calls (0 = no limit).
    "maxLineLength": 120,
    // Space around assignments := => S= R= REF=.
    "spaceAroundAssignment": true,
    // Space before ':=' and '=>' of call arguments. Off gives the TwinCAT F2 style 'fbTimer(IN:= bStart, Q=> bDone)'.
    "spaceBeforeArgumentAssignment": true,
    // Space around binary operators + - * / ** = <> < > <= >= &.
    "spaceAroundOperators": true,
    // Space after a comma.
    "spaceAfterComma": true,
    // Space before a comma.
    "spaceBeforeComma": false,
    // Space directly inside parentheses: '( a )'.
    "spaceInsideParentheses": false,
    // Space directly inside brackets: '[ i ]'.
    "spaceInsideBrackets": false,
    // Space between a called name and its '(': 'fbTimer (IN := x)'.
    "spaceBeforeCallParenthesis": false,
    // Space between ARRAY and '[': 'ARRAY [1..10]'.
    "spaceAfterArrayKeyword": false,
    // Space around the range operator '..'.
    "spaceAroundRange": false,
    // Space before ':' in declarations ('nValue : INT').
    "spaceBeforeColon": true,
    // Space after ':' in declarations.
    "spaceAfterColon": true,
    // Insert a space after '//' when the comment starts with a letter or digit.
    "spaceAfterLineCommentStart": true,
    // Minimum spaces between code and a trailing comment.
    "spacesBeforeTrailingComment": 1,
    // Casing of keywords (IF, THEN, VAR, AND, ...). Values: Preserve | Upper | Lower.
    "keywordCasing": "Upper",
    // Casing of elementary data types (BOOL, INT, STRING, ...). Values: Preserve | Upper | Lower.
    "typeCasing": "Upper",
    // Casing of literal prefixes and hex digits (TRUE, 16#FF, T#1S, INT#5). Values: Preserve | Upper | Lower.
    "literalCasing": "Upper",
    // Casing of time literal units (T#1s500ms vs T#1S500MS). Values: Preserve | Upper | Lower.
    "timeUnitCasing": "Preserve",
    // Align the ':' of consecutive declarations.
    "alignDeclarationColons": true,
    // Align the ':=' initializers of consecutive declarations.
    "alignDeclarationInitializers": true,
    // Align trailing comments of consecutive declarations. Values: None | AlignInBlock.
    "declarationCommentAlignment": "AlignInBlock",
    // Blank lines interrupt an alignment block.
    "blankLineBreaksAlignment": true,
    // Declarations whose name is longer than this are not used to compute alignment (0 = no limit).
    "maxAlignedNameLength": 40,
    // Put the data type of declarations at this fixed column (1-based, tabs count as IndentSize). 0 = align automatically. Example: type at tab 10 with tab width 4 = 37.
    "declarationTypeColumn": 0,
    // Align the ':=' of enum members.
    "alignEnumValues": true,
    // Semicolon after END_IF / END_CASE / END_FOR / END_WHILE / END_REPEAT. Values: Preserve | Add | Remove.
    "endKeywordSemicolon": "Preserve",
    // Align trailing comments of consecutive code lines. Values: None | AlignInBlock.
    "codeCommentAlignment": "None",
    // Align ':=' of consecutive simple assignments.
    "alignConsecutiveAssignments": false,
    // Wrap calls with named arguments that exceed MaxLineLength (one argument per line).
    "wrapLongCalls": true,
    // Always wrap calls with at least this many named arguments (0 = only when too long).
    "wrapCallsWithArgumentsAtLeast": 0,
    // Layout of wrapped calls. Values: OnePerLineIndented | AlignWithOpeningParenthesis.
    "callWrapStyle": "OnePerLineIndented",
    // Put the closing parenthesis of a wrapped call on its own line.
    "wrappedCallClosingParenthesisOnNewLine": false,
    // Align ':=' and '=>' of the arguments of wrapped calls.
    "alignWrappedArguments": true,
    // Re-join call statements that were wrapped over several lines (without comments inside) before deciding how to wrap them. Makes call layout fully deterministic, like Black.
    "rejoinWrappedCalls": true
  },
  "naming": {
    // Enable the naming check.
    "enabled": true,
    // Severity per rule: TCN001 object prefix, TCN002 variable prefix, TCN003 method/property name, TCN004 enum value, TCN005 invalid identifier. Values: Off, Info, Warning, Error.
    "severities": {},
    // Severity of rules without an entry in 'severities'. Values: Off | Info | Warning | Error.
    "defaultSeverity": "Warning",
    // Variable prefix per data type. '*' is a wildcard (e.g. FB_*), alternatives are separated by ',' (e.g. n,i). Unknown types are not checked.
    "typePrefixes": {
      "BOOL": "b",
      "BIT": "b",
      "BYTE": "n,i",
      "WORD": "n,i",
      "DWORD": "n,i",
      "LWORD": "n,i",
      "SINT": "n,i",
      "USINT": "n,i",
      "INT": "n,i",
      "UINT": "n,i",
      "DINT": "n,i",
      "UDINT": "n,i",
      "LINT": "n,i",
      "ULINT": "n,i",
      "XINT": "n,i",
      "UXINT": "n,i",
      "XWORD": "n,i",
      "__XINT": "n,i",
      "__UXINT": "n,i",
      "__XWORD": "n,i",
      "PVOID": "p",
      "REAL": "f",
      "LREAL": "f",
      "STRING": "s",
      "WSTRING": "ws,s",
      "TIME": "t",
      "LTIME": "t",
      "DATE": "d",
      "LDATE": "d",
      "DATE_AND_TIME": "dt",
      "DT": "dt",
      "LDT": "dt",
      "TIME_OF_DAY": "tod",
      "TOD": "tod",
      "LTOD": "tod",
      "TON": "fb",
      "TOF": "fb",
      "TP": "fb",
      "LTON": "fb",
      "LTOF": "fb",
      "LTP": "fb",
      "R_TRIG": "fb",
      "F_TRIG": "fb",
      "CTU": "fb",
      "CTD": "fb",
      "CTUD": "fb",
      "RS": "fb",
      "SR": "fb",
      "FB_*": "fb",
      "MC_*": "fb",
      "ST_*": "st",
      "E_*": "e",
      "I_*": "i,ip"
    },
    // Prefix of ARRAY variables.
    "arrayPrefix": "a",
    // Arrays also need the element prefix (ARRAY OF BOOL -> ab).
    "arrayIncludesElementPrefix": false,
    // Prefix of POINTER variables.
    "pointerPrefix": "p",
    // Pointers also need the target prefix (POINTER TO INT -> pn).
    "pointerIncludesTargetPrefix": false,
    // Prefix of REFERENCE variables.
    "referencePrefix": "ref",
    // References also need the target prefix.
    "referenceIncludesTargetPrefix": false,
    // Additional accepted prefix for constants (VAR CONSTANT). Empty = none.
    "constantPrefix": "c",
    // Casing of constant names after the prefix (Any, PascalCase, UpperCase). UpperCase: 'dn_MAX_LIGHT_CYCLES'. Values: Any | PascalCase | UpperCase.
    "constantNameCase": "Any",
    // Text required after the type prefix of local variables (VAR / VAR_TEMP) of methods, e.g. 'Temp' -> 'lr_TempAngle'. Empty = none.
    "methodLocalMarker": "",
    // Prefix required before the type prefix per section, e.g. VAR_GLOBAL: g -> gbStop. Keys: VAR, VAR_INPUT, VAR_OUTPUT, VAR_IN_OUT, VAR_GLOBAL, VAR_TEMP, VAR_STAT, VAR_INST, STRUCT.
    "scopePrefixes": {},
    // Name prefix per object kind (FUNCTION_BLOCK, FUNCTION, PROGRAM, INTERFACE, STRUCT, ENUM, UNION, ALIAS, GVL, METHOD, PROPERTY, ACTION). Empty = PascalCase without prefix.
    "objectPrefixes": {
      "FUNCTION_BLOCK": "FB_",
      "FUNCTION": "F_",
      "PROGRAM": "P_",
      "INTERFACE": "I_",
      "STRUCT": "ST_",
      "ENUM": "E_",
      "UNION": "U_",
      "ALIAS": "T_",
      "GVL": "GVL_",
      "METHOD": "",
      "PROPERTY": "",
      "ACTION": ""
    },
    // The character after a prefix must be an upper case letter or digit.
    "requirePascalCaseAfterPrefix": true,
    // Allow '_' in method, property and action names.
    "allowUnderscoreInMemberNames": false,
    // Casing of enum values (Any, PascalCase, UpperCase). Values: Any | PascalCase | UpperCase.
    "enumValueCase": "PascalCase",
    // Allow names that start with '_' (e.g. object prefixes like _FB_ / _FC_).
    "allowLeadingUnderscore": false,
    // Regular expressions of names that are never reported.
    "ignoreNames": ["^MAIN$"],
    // Variable sections that are checked.
    "checkedSections": ["VAR", "VAR_INPUT", "VAR_OUTPUT", "VAR_IN_OUT", "VAR_GLOBAL", "VAR_TEMP", "VAR_STAT", "VAR_INST", "STRUCT"]
  }
}
