<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="TcFormatter.6a1f5d0e-3c2b-4b8e-9f47-2d8c1e5a7b90" Version="1.0.0" Language="en-US" Publisher="Jan Willner" />
    <DisplayName>TcFormatter</DisplayName>
    <Description xml:space="preserve">Code formatter and naming convention checker for TwinCAT 3 Structured Text. Formats single objects, folders or whole PLC projects. Configurable via Tools &gt; Options &gt; TcFormatter or a .tcformat.json file.</Description>
    <MoreInfo>https://github.com/janwillner/Twincat_Codeformatter</MoreInfo>
    <Icon>Resources\TcFormatter.png</Icon>
    <Tags>TwinCAT;Structured Text;IEC 61131-3;formatter;naming</Tags>
  </Metadata>
  <Installation AllUsers="true">
    <!-- TwinCAT 3.1.4024: TcXaeShell based on VS 2017/2019 (32 bit) -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[15.0,17.0)">
      <ProductArchitecture>x86</ProductArchitecture>
    </InstallationTarget>
    <!-- TwinCAT 3.1.4026: TcXaeShell based on VS 2022 (64 bit) -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[15.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
